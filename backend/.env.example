# ==============================================================================
# TECMOTIV ERP — Backend Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' on your production server or hosting platform.
# NEVER commit the actual '.env' file or production credentials to GitHub.
# ==============================================================================

# Database: MongoDB Connection URI (e.g. MongoDB Atlas Replica Set)
DATABASE=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tecmotiv-erp?retryWrites=true&w=majority

# Server Runtime
PORT=8888
NODE_ENV=production

# Authentication Secret (Generate a strong 64-character random string)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-string

# Public Frontend Client URL (For CORS and password-reset email links)
# Multiple comma-separated origins can be supplied if using preview URLs
CLIENT_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Public Backend URL (For static assets and file downloads)
PUBLIC_SERVER_FILE=https://your-api.onrender.com/

# Email Service (SMTP, Gmail App Password, or Resend)
EMAIL_SERVICE=gmail
EMAIL_USER=erp-notifications@example.com
EMAIL_PASS=your-secure-email-app-password
EMAIL_FROM=TecMotiv ERP <noreply@example.com>

# Third-Party Integrations (Optional)
RESEND_API=
OPENAI_API_KEY=

# GitHub Workspace & Webhooks Integration (Optional)
# Personal Access Token with 'repo' scope for Tecmotiv-Solutions private repos
GITHUB_TOKEN=
# Webhook HMAC secret configured in GitHub repo webhook settings
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
