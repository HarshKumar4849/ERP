# ==============================================================================
# TECMOTIV ERP — Frontend Vercel Environment Configuration Template
# ==============================================================================
# Configure these variables in the Vercel Project Settings > Environment Variables.
# ==============================================================================

# Target Backend Server API Base URL (Render, Railway, or VPS hosting backend)
VITE_BACKEND_SERVER=https://your-backend-api.onrender.com/

# Static / Uploaded Assets Base URL (Usually same as backend or AWS S3 CDN)
VITE_FILE_BASE_URL=https://your-backend-api.onrender.com/

# Public Canonical Website URL
VITE_WEBSITE_URL=https://your-app.vercel.app/

# Optional External Integration Dashboards
VITE_SHOUTOUT_URL=https://shoutout-three.vercel.app/dashboard
