{
  "name": "tecmotiv-erp",
  "version": "4.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x <=24.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "deploy:prod": "vercel build --prod && node scripts/patch-vercel-shims.js && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.7.1",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "mongoose": "^9.11.2"
  }
}
